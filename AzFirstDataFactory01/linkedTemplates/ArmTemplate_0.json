		{
			"name": "[concat(parameters('factoryName'), '/salesdata_invalid_dataflow')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "salesData_invalid",
								"type": "DatasetReference"
							},
							"name": "excelsource"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "firstdestination",
								"type": "DatasetReference"
							},
							"name": "validDataSink"
						},
						{
							"dataset": {
								"referenceName": "firstdestination",
								"type": "DatasetReference"
							},
							"name": "InvalidDataSink"
						}
					],
					"transformations": [
						{
							"name": "split1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          Sno as string,",
						"          Region as string,",
						"          Country as string,",
						"          {Item Type} as string,",
						"          {Sales Channel} as string,",
						"          {Order Priority} as string,",
						"          {Order Date} as string,",
						"          {Order ID} as string,",
						"          {Ship Date} as string,",
						"          {Units Sold} as string,",
						"          {Unit Price} as string,",
						"          {Unit Cost} as string,",
						"          {Total Revenue} as string,",
						"          {Total Cost} as string,",
						"          {Total Profit} as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> excelsource",
						"excelsource split(isInteger(Sno),",
						"     disjoint: false) ~> split1@(validOutput, invalidOutput)",
						"split1@validOutput sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     partitionFileNames:['validDataSink.csv'],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> validDataSink",
						"split1@invalidOutput sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     partitionFileNames:['InvalidDataSink.csv'],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> InvalidDataSink"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/salesData_invalid')]",
				"[concat(variables('factoryId'), '/datasets/firstdestination')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/fixedwithdataflow')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "fixedwidthsource",
								"type": "DatasetReference"
							},
							"name": "fixedwidthsource"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "firstdestination",
								"type": "DatasetReference"
							},
							"name": "fixedWidthSink"
						}
					],
					"transformations": [
						{
							"name": "derivefixedColumnsWithSubstring"
						},
						{
							"name": "select1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          {CustId CustumerName        CustumerCity   CustomerPhone Subscription} as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> fixedwidthsource",
						"fixedwidthsource derive(customerId = substring({CustId CustumerName        CustumerCity   CustomerPhone Subscription}, 1,7),",
						"          CustumerName = substring({CustId CustumerName        CustumerCity   CustomerPhone Subscription}, 8,20),",
						"          customerCity = substring({CustId CustumerName        CustumerCity   CustomerPhone Subscription}, 28,15),",
						"          CustomerPhone = substring({CustId CustumerName        CustumerCity   CustomerPhone Subscription}, 43,14),",
						"          Subscription = substring({CustId CustumerName        CustumerCity   CustomerPhone Subscription}, 57,4)) ~> derivefixedColumnsWithSubstring",
						"derivefixedColumnsWithSubstring select(mapColumn(",
						"          customerId,",
						"          CustumerName,",
						"          customerCity,",
						"          CustomerPhone,",
						"          Subscription",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select1",
						"select1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     partitionFileNames:['fixedWidthOutput.csv'],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> fixedWidthSink"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/fixedwidthsource')]",
				"[concat(variables('factoryId'), '/datasets/firstdestination')]"
			]
		}
	]
