		{
			"name": "[concat(parameters('factoryName'), '/11_1_SCD_Type1_Dataflow')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "srcInputEmployeeFile",
								"type": "DatasetReference"
							},
							"name": "srcEmployeeInputFile"
						},
						{
							"dataset": {
								"referenceName": "sqlTblDestination",
								"type": "DatasetReference"
							},
							"name": "lkpEmployeeTable"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "azIncrementalLoadDestination",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "join1"
						},
						{
							"name": "alterRow1"
						},
						{
							"name": "select1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          {Emp ID} as integer,",
						"          {Name Prefix} as string,",
						"          {First Name} as string,",
						"          {Middle Initial} as string,",
						"          {Last Name} as string,",
						"          Gender as string,",
						"          {E Mail} as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> srcEmployeeInputFile",
						"source(output(",
						"          EmpID as integer,",
						"          NamePrefix as string,",
						"          FirstName as string,",
						"          MiddleInitial as string,",
						"          LastName as string,",
						"          Gender as string,",
						"          EMail as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> lkpEmployeeTable",
						"srcEmployeeInputFile, lkpEmployeeTable join({Emp ID} == EmpID,",
						"     joinType:'left',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> join1",
						"join1 alterRow(insertIf(isNull(EmpID)),",
						"     updateIf(!isNull(EmpID))) ~> alterRow1",
						"alterRow1 select(mapColumn(",
						"          {Emp ID},",
						"          {Name Prefix},",
						"          {First Name},",
						"          {Middle Initial},",
						"          {Last Name},",
						"          Gender = srcEmployeeInputFile@Gender,",
						"          {E Mail}",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select1",
						"select1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          EmpID as integer,",
						"          NamePrefix as string,",
						"          FirstName as string,",
						"          MiddleInitial as string,",
						"          LastName as string,",
						"          Gender as string,",
						"          EMail as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:true,",
						"     upsertable:true,",
						"     keys:['EmpID'],",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          EmpID = {Emp ID},",
						"          NamePrefix = {Name Prefix},",
						"          FirstName = {First Name},",
						"          MiddleInitial = {Middle Initial},",
						"          LastName = {Last Name},",
						"          Gender,",
						"          EMail = {E Mail}",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/13_1_SCD_Type2_Dataflow')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "scd2_srcInputFile",
								"type": "DatasetReference"
							},
							"name": "scd2inputsrcfile"
						},
						{
							"dataset": {
								"referenceName": "scd2sqldesttable",
								"type": "DatasetReference"
							},
							"name": "lkpscd2destinationTable"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "scd2sqldesttable",
								"type": "DatasetReference"
							},
							"name": "updateoldsink"
						},
						{
							"dataset": {
								"referenceName": "scd2sqldesttable",
								"type": "DatasetReference"
							},
							"name": "insertnewsink"
						},
						{
							"dataset": {
								"referenceName": "scd2_type1_sql_db",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "join1"
						},
						{
							"name": "split2"
						},
						{
							"name": "insertNew"
						},
						{
							"name": "updateOldDB"
						},
						{
							"name": "flagInsertNew"
						},
						{
							"name": "flagUpdateExisting"
						},
						{
							"name": "updateExistingSrc"
						},
						{
							"name": "select1"
						},
						{
							"name": "select2"
						},
						{
							"name": "updateExistingSrcflag"
						},
						{
							"name": "select3"
						}
					],
					"scriptLines": [
						"source(output(",
						"          {Emp ID} as integer,",
						"          {Name Prefix} as string,",
						"          {First Name} as string,",
						"          {Middle Initial} as string,",
						"          {Last Name} as string,",
						"          Gender as string,",
						"          {E Mail} as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> scd2inputsrcfile",
						"source(output(",
						"          EmpID as integer,",
						"          NamePrefix as string,",
						"          FirstName as string,",
						"          MiddleInitial as string,",
						"          LastName as string,",
						"          Gender as string,",
						"          EMail as string,",
						"          Active as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> lkpscd2destinationTable",
						"scd2inputsrcfile, lkpscd2destinationTable join({Emp ID} == EmpID,",
						"     joinType:'outer',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> join1",
						"join1 split(!isNull({Emp ID}) && isNull(EmpID),",
						"     isNull({Emp ID}) && !isNull(EmpID),",
						"     disjoint: false) ~> split2@(InsertNew, UpdateOldInDB, UpdateExistingFromSrc)",
						"split2@InsertNew alterRow(insertIf(1==1)) ~> insertNew",
						"split2@UpdateOldInDB alterRow(updateIf(1==1)) ~> updateOldDB",
						"insertNew derive(insertNew = 1) ~> flagInsertNew",
						"updateOldDB derive(updateOldFromDB = 0) ~> flagUpdateExisting",
						"split2@UpdateExistingFromSrc alterRow(updateIf(1==1)) ~> updateExistingSrc",
						"flagInsertNew select(mapColumn(",
						"          {Emp ID},",
						"          {Name Prefix},",
						"          {First Name},",
						"          {Middle Initial},",
						"          {Last Name},",
						"          Gender = split2@InsertNew@Gender,",
						"          {E Mail},",
						"          EmpID,",
						"          NamePrefix,",
						"          FirstName,",
						"          MiddleInitial,",
						"          LastName,",
						"          Gender = split2@InsertNew@Gender,",
						"          EMail,",
						"          Active,",
						"          insertNew",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select1",
						"flagUpdateExisting select(mapColumn(",
						"          {Emp ID} = EmpID,",
						"          {Name Prefix},",
						"          {First Name},",
						"          {Middle Initial},",
						"          {Last Name},",
						"          Gender = split2@UpdateOldInDB@Gender,",
						"          {E Mail},",
						"          EmpID,",
						"          NamePrefix,",
						"          FirstName,",
						"          MiddleInitial,",
						"          LastName,",
