		{
			"name": "[concat(parameters('factoryName'), '/11SCDType1')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "verify if dst table exists or not",
						"type": "GetMetadata",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataset": {
								"referenceName": "AzureSqldstTableCheck",
								"type": "DatasetReference",
								"parameters": {}
							},
							"fieldList": [
								"exists"
							]
						}
					},
					{
						"name": "If condtion check dst table",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "verify if dst table exists or not",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@not(activity('verify if dst table exists or not').output.exists)",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "Execute copy pipeline",
									"type": "ExecutePipeline",
									"dependsOn": [],
									"policy": {
