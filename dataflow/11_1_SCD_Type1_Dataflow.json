{
	"name": "11_1_SCD_Type1_Dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "srcInputEmployeeFile",
						"type": "DatasetReference"
					},
					"name": "srcEmployeeInputFile"
				},
				{
					"dataset": {
						"referenceName": "sqlTblDestination",
						"type": "DatasetReference"
					},
					"name": "lkpEmployeeTable"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "AzureSqldstTableCheck",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "select1"
				},
				{
					"name": "select2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {Emp ID} as integer,",
				"          {Name Prefix} as string,",
				"          {First Name} as string,",
				"          {Middle Initial} as string,",
				"          {Last Name} as string,",
				"          Gender as string,",
				"          {E Mail} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcEmployeeInputFile",
				"source(output(",
				"          EmpID as integer,",
				"          NamePrefix as string,",
				"          FirstName as string,",
				"          MiddleInitial as string,",
				"          LastName as string,",
				"          Gender as string,",
				"          EMail as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> lkpEmployeeTable",
				"select1, lkpEmployeeTable join(srcEmpID == EmpID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"select2 alterRow(insertIf(isNull(EmpID)),",
				"     updateIf(!isNull(EmpID)&&!isNull(srcEmpID))) ~> alterRow1",
				"srcEmployeeInputFile select(mapColumn(",
				"          srcEmpID = {Emp ID},",
				"          srcNamePrefix = {Name Prefix},",
				"          srcFirstName = {First Name},",
				"          srcMiddleInitial = {Middle Initial},",
				"          srcLastName = {Last Name},",
				"          srcGender = Gender,",
				"          srcEMail = {E Mail}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"join1 select(mapColumn(",
				"          srcEmpID,",
				"          srcNamePrefix,",
				"          srcFirstName,",
				"          srcMiddleInitial,",
				"          srcLastName,",
				"          srcGender,",
				"          srcEMail,",
				"          EmpID,",
				"          NamePrefix,",
				"          FirstName,",
				"          MiddleInitial,",
				"          LastName,",
				"          Gender,",
				"          EMail",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     keys:['srcEmpID'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          srcEmpID = EmpID,",
				"          srcNamePrefix = NamePrefix,",
				"          srcFirstName = FirstName,",
				"          srcMiddleInitial = MiddleInitial,",
				"          srcLastName = LastName,",
				"          srcGender = Gender,",
				"          srcEMail = EMail",
				"     )) ~> sink1"
			]
		}
	}
}