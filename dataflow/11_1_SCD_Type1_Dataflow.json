{
	"name": "11_1_SCD_Type1_Dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "srcInputEmployeeFile",
						"type": "DatasetReference"
					},
					"name": "srcEmployeeInputFile"
				},
				{
					"dataset": {
						"referenceName": "sqlTblDestination",
						"type": "DatasetReference"
					},
					"name": "lkpEmployeeTable"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "azIncrementalLoadDestination",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "alterRow1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {Emp ID} as integer,",
				"          {Name Prefix} as string,",
				"          {First Name} as string,",
				"          {Middle Initial} as string,",
				"          {Last Name} as string,",
				"          Gender as string,",
				"          {E Mail} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcEmployeeInputFile",
				"source(output(",
				"          EmpID as integer,",
				"          NamePrefix as string,",
				"          FirstName as string,",
				"          MiddleInitial as string,",
				"          LastName as string,",
				"          Gender as string,",
				"          EMail as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> lkpEmployeeTable",
				"srcEmployeeInputFile, lkpEmployeeTable join({Emp ID} == EmpID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 alterRow(insertIf(isNull(EmpID)),",
				"     updateIf(!isNull(EmpID))) ~> alterRow1",
				"alterRow1 sink(allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     input(",
				"          EmpID as integer,",
				"          NamePrefix as string,",
				"          FirstName as string,",
				"          MiddleInitial as string,",
				"          LastName as string,",
				"          Gender as string,",
				"          EMail as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:true,",
				"     keys:['EmpID'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          EmpID,",
				"          NamePrefix,",
				"          FirstName,",
				"          MiddleInitial,",
				"          LastName,",
				"          Gender = lkpEmployeeTable@Gender,",
				"          EMail",
				"     )) ~> sink1"
			]
		}
	}
}