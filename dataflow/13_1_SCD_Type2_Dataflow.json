{
	"name": "13_1_SCD_Type2_Dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "scd2_srcInputFile",
						"type": "DatasetReference"
					},
					"name": "scd2inputsrcfile"
				},
				{
					"dataset": {
						"referenceName": "scd2sqldesttable",
						"type": "DatasetReference"
					},
					"name": "lkpscd2destinationTable"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "scd2sqldesttable",
						"type": "DatasetReference"
					},
					"name": "updateoldsink"
				},
				{
					"dataset": {
						"referenceName": "scd2sqldesttable",
						"type": "DatasetReference"
					},
					"name": "insertnewsink"
				},
				{
					"dataset": {
						"referenceName": "scd2_type1_sql_db",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "split2"
				},
				{
					"name": "insertNew"
				},
				{
					"name": "updateOldDB"
				},
				{
					"name": "flagInsertNew"
				},
				{
					"name": "flagUpdateExisting"
				},
				{
					"name": "updateExistingSrc"
				},
				{
					"name": "select1"
				},
				{
					"name": "select2"
				},
				{
					"name": "updateExistingSrcflag"
				},
				{
					"name": "select3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {Emp ID} as integer,",
				"          {Name Prefix} as string,",
				"          {First Name} as string,",
				"          {Middle Initial} as string,",
				"          {Last Name} as string,",
				"          Gender as string,",
				"          {E Mail} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> scd2inputsrcfile",
				"source(output(",
				"          EmpID as integer,",
				"          NamePrefix as string,",
				"          FirstName as string,",
				"          MiddleInitial as string,",
				"          LastName as string,",
				"          Gender as string,",
				"          EMail as string,",
				"          Active as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> lkpscd2destinationTable",
				"scd2inputsrcfile, lkpscd2destinationTable join({Emp ID} == EmpID,",
				"     joinType:'outer',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 split(!isNull({Emp ID}) && isNull(EmpID),",
				"     isNull({Emp ID}) && !isNull(EmpID),",
				"     disjoint: false) ~> split2@(InsertNew, UpdateOldInDB, UpdateExistingFromSrc)",
				"split2@InsertNew alterRow(insertIf(1==1)) ~> insertNew",
				"split2@UpdateOldInDB alterRow(upsertIf(1==1)) ~> updateOldDB",
				"insertNew derive(insertNew = 1) ~> flagInsertNew",
				"updateOldDB derive(updateOldFromDB = 0) ~> flagUpdateExisting",
				"split2@UpdateExistingFromSrc alterRow(updateIf(1==1)) ~> updateExistingSrc",
				"flagInsertNew select(mapColumn(",
				"          {Emp ID},",
				"          {Name Prefix},",
				"          {First Name},",
				"          {Middle Initial},",
				"          {Last Name},",
				"          Gender = split2@InsertNew@Gender,",
				"          {E Mail},",
				"          EmpID,",
				"          NamePrefix,",
				"          FirstName,",
				"          MiddleInitial,",
				"          LastName,",
				"          Gender = split2@InsertNew@Gender,",
				"          EMail,",
				"          Active,",
				"          insertNew",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"flagUpdateExisting select(mapColumn(",
				"          {Emp ID},",
				"          {Name Prefix},",
				"          {First Name},",
				"          {Middle Initial},",
				"          {Last Name},",
				"          Gender = split2@UpdateOldInDB@Gender,",
				"          {E Mail},",
				"          EmpID,",
				"          NamePrefix,",
				"          FirstName,",
				"          MiddleInitial,",
				"          LastName,",
				"          Gender = split2@UpdateOldInDB@Gender,",
				"          EMail,",
				"          Active,",
				"          updateOldFromDB",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"updateExistingSrc derive(updateExistingFlag = 1) ~> updateExistingSrcflag",
				"updateExistingSrcflag select(mapColumn(",
				"          {Emp ID},",
				"          {Name Prefix},",
				"          {First Name},",
				"          {Middle Initial},",
				"          {Last Name},",
				"          Gender = split2@UpdateExistingFromSrc@Gender,",
				"          {E Mail},",
				"          EmpID,",
				"          NamePrefix,",
				"          FirstName,",
				"          MiddleInitial,",
				"          LastName,",
				"          Gender = split2@UpdateExistingFromSrc@Gender,",
				"          EMail,",
				"          Active,",
				"          updateExistingFlag",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          EmpID as integer,",
				"          NamePrefix as string,",
				"          FirstName as string,",
				"          MiddleInitial as string,",
				"          LastName as string,",
				"          Gender as string,",
				"          EMail as string,",
				"          Active as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:true,",
				"     upsertable:false,",
				"     keys:['EmpID'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          EmpID,",
				"          NamePrefix,",
				"          FirstName,",
				"          MiddleInitial,",
				"          LastName,",
				"          Gender,",
				"          EMail,",
				"          Active = updateExistingFlag",
				"     )) ~> updateoldsink",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          EmpID as integer,",
				"          NamePrefix as string,",
				"          FirstName as string,",
				"          MiddleInitial as string,",
				"          LastName as string,",
				"          Gender as string,",
				"          EMail as string,",
				"          Active as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          EmpID = {Emp ID},",
				"          NamePrefix = {Name Prefix},",
				"          FirstName = {First Name},",
				"          MiddleInitial = {Middle Initial},",
				"          LastName = {Last Name},",
				"          Gender,",
				"          EMail = {E Mail},",
				"          Active = insertNew",
				"     )) ~> insertnewsink",
				"select2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          EmpID as integer,",
				"          NamePrefix as string,",
				"          FirstName as string,",
				"          MiddleInitial as string,",
				"          LastName as string,",
				"          Gender as string,",
				"          EMail as string,",
				"          Active as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:true,",
				"     upsertable:false,",
				"     keys:['EmpID'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          EmpID = {Emp ID},",
				"          NamePrefix,",
				"          FirstName,",
				"          MiddleInitial,",
				"          LastName,",
				"          Gender,",
				"          EMail,",
				"          Active = updateOldFromDB",
				"     )) ~> sink1"
			]
		}
	}
}