{
	"name": "13_1_SCD_Type2_Dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "srcInputEmployeeFile",
						"type": "DatasetReference"
					},
					"name": "srcEmployeeInputFile"
				},
				{
					"dataset": {
						"referenceName": "scd_type2_lkp",
						"type": "DatasetReference"
					},
					"name": "lkpEmployeeTable"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "scd2_type1_sql_db",
						"type": "DatasetReference"
					},
					"name": "sink1"
				},
				{
					"dataset": {
						"referenceName": "scd2_type1_sql_db",
						"type": "DatasetReference"
					},
					"name": "sink2"
				}
			],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "alterRow1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {Emp ID} as integer,",
				"          {Name Prefix} as string,",
				"          {First Name} as string,",
				"          {Middle Initial} as string,",
				"          {Last Name} as string,",
				"          Gender as string,",
				"          {E Mail} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcEmployeeInputFile",
				"source(output(",
				"          EmpID as integer,",
				"          NamePrefix as string,",
				"          FirstName as string,",
				"          MiddleInitial as string,",
				"          LastName as string,",
				"          Gender as string,",
				"          EMail as string,",
				"          Active as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'select * from dbo.SimpleEmployeeData_scd2_type1',",
				"     format: 'query') ~> lkpEmployeeTable",
				"srcEmployeeInputFile, lkpEmployeeTable join({Emp ID} == EmpID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 split(!isNull(EmpID),",
				"     disjoint: false) ~> split1@(Update, New)",
				"alterRow1 derive(InActiveFlag = 0) ~> derivedColumn1",
				"split1@New derive(ActiveFlag = 1) ~> derivedColumn2",
				"split1@Update alterRow(upsertIf(1==1)) ~> alterRow1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          EmpID as integer,",
				"          NamePrefix as string,",
				"          FirstName as string,",
				"          MiddleInitial as string,",
				"          LastName as string,",
				"          Gender as string,",
				"          EMail as string,",
				"          Active as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     keys:['EmpID'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          EmpID = {Emp ID},",
				"          NamePrefix = {Name Prefix},",
				"          FirstName = {First Name},",
				"          MiddleInitial = {Middle Initial},",
				"          LastName,",
				"          Gender = split1@Update@Gender,",
				"          EMail = {E Mail},",
				"          Active = InActiveFlag",
				"     )) ~> sink1",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          EmpID as integer,",
				"          NamePrefix as string,",
				"          FirstName as string,",
				"          MiddleInitial as string,",
				"          LastName as string,",
				"          Gender as string,",
				"          EMail as string,",
				"          Active as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          EmpID = {Emp ID},",
				"          NamePrefix = {Name Prefix},",
				"          FirstName = {Name Prefix},",
				"          MiddleInitial = {Middle Initial},",
				"          LastName = {Last Name},",
				"          Gender = split1@New@Gender,",
				"          EMail = {E Mail},",
				"          Active = ActiveFlag",
				"     )) ~> sink2"
			]
		}
	}
}