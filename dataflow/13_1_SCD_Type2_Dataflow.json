{
	"name": "13_1_SCD_Type2_Dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "scd2_srcInputFile",
						"type": "DatasetReference"
					},
					"name": "scd2inputsrcfile"
				},
				{
					"dataset": {
						"referenceName": "scd2sqldesttable",
						"type": "DatasetReference"
					},
					"name": "lkpscd2destinationTable"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "alterRow1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {Emp ID} as integer,",
				"          {Name Prefix} as string,",
				"          {First Name} as string,",
				"          {Middle Initial} as string,",
				"          {Last Name} as string,",
				"          Gender as string,",
				"          {E Mail} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> scd2inputsrcfile",
				"source(output(",
				"          EmpID as integer,",
				"          NamePrefix as string,",
				"          FirstName as string,",
				"          MiddleInitial as string,",
				"          LastName as string,",
				"          Gender as string,",
				"          EMail as string,",
				"          Active as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> lkpscd2destinationTable",
				"scd2inputsrcfile, lkpscd2destinationTable join({Emp ID} == EmpID,",
				"     joinType:'outer',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 alterRow() ~> alterRow1"
			]
		}
	}
}