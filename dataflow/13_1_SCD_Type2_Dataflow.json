{
	"name": "13_1_SCD_Type2_Dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "srcInputEmployeeFile",
						"type": "DatasetReference"
					},
					"name": "srcEmployeeInputFile"
				},
				{
					"dataset": {
						"referenceName": "scd_type2_lkp",
						"type": "DatasetReference"
					},
					"name": "lkpEmployeeTable"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {Emp ID} as integer,",
				"          {Name Prefix} as string,",
				"          {First Name} as string,",
				"          {Middle Initial} as string,",
				"          {Last Name} as string,",
				"          Gender as string,",
				"          {E Mail} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcEmployeeInputFile",
				"source(output(",
				"          EmpID as integer,",
				"          NamePrefix as string,",
				"          FirstName as string,",
				"          MiddleInitial as string,",
				"          LastName as string,",
				"          Gender as string,",
				"          EMail as string,",
				"          Active as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'select * from dbo.SimpleEmployeeData_scd2_type1',",
				"     format: 'query') ~> lkpEmployeeTable",
				"srcEmployeeInputFile, lkpEmployeeTable join({Emp ID} == EmpID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 derive(New = {Emp ID}!=EmpID,",
				"          update = {Emp ID}==EmpID) ~> derivedColumn1"
			]
		}
	}
}