					"dataset": {
						"referenceName": "copy_all_files_destination",
						"type": "DatasetReference"
					},
					"enableLogging": false,
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"recursive": true,
						"modifiedDatetimeStart": "2025-05-10T12:00:00.000Z",
						"modifiedDatetimeEnd": "2025-05-10T14:00:00.000Z",
						"enablePartitionDiscovery": false
					}
				}
			}
		],
		"annotations": []
	}
}